# LLM Provider — GROQ (ultra-fast Llama 3.3)
GROQ_API_KEY=

# Optional: alternate providers (leave blank if not used)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# JARVIS Settings
JARVIS_NAME=JARVIS
JARVIS_MODEL=openai/gpt-oss-120b
JARVIS_TEMPERATURE=0.7

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Notes Storage
NOTES_FILE=./jarvis_notes.json
